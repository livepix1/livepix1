// PixLive — Prisma schema
// Sessão de auth = JWT (ver src/lib/auth.ts). A tabela Session fica intencionalmente
// vazia: existe só porque o PrismaAdapter a referencia. NÃO "consertar" isso.
// username vive no User (não no PaymentLink) — rotas públicas resolvem User por username.
// PaymentLink/Charge = modo autônomo (links de cobrança), INTOCADOS.
// Novos modelos (F0): perfil de criador, doações com alertas, metas, campanhas,
// assinaturas, carteira com ledger APPEND-ONLY (LedgerEntry nunca sofre UPDATE/DELETE).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  username     String?  @unique
  passwordHash String?
  avatar       String?
  cpf          String?
  accountType  String   @default("PF") // PF ou CNPJ
  profileType  String   @default("CREATOR") // CREATOR, SUPPORTER, SELLER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pixKey String?

  // 2FA (F7) — TOTP obrigatório no saque quando ativado.
  totpSecretEnc String? // segredo cifrado (AES-GCM, src/lib/crypto.ts) — nunca em claro
  totpEnabled   Boolean @default(false)

  paymentLinks     PaymentLink[]
  charges          Charge[]
  withdrawals      Withdrawal[]
  accounts         Account[]
  sessions         Session[]
  creatorProfile   CreatorProfile?
  donations        Donation[]
  alertConfig      AlertConfig?
  alertEvents      AlertEvent[]
  goals            Goal[]
  campaigns        Campaign[]
  plans            CreatorPlan[]
  wallet           Wallet?
  providerAccount  ProviderAccount?
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  socialConnections SocialConnection[]
  polls            Poll[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ MODO AUTÔNOMO (links de cobrança — intocado) ============

model PaymentLink {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  linkType    String   @default("VALOR_FIXO") // VALOR_FIXO, DOACAO, CONSULTORIA
  value       Decimal? // null = valor variável / doação
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@index([userId])
}

model Charge {
  id            String    @id @default(cuid())
  paymentLinkId String
  userId        String
  payerName     String
  payerEmail    String
  payerMessage  String?
  payerPixKey   String?
  amount        Decimal
  status        String    @default("PENDING") // PENDING, PAID, FAILED
  asaasChargeId String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  paymentLink PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentLinkId])
}

model Withdrawal {
  id                 String    @id @default(cuid())
  userId             String
  amount             Decimal
  fee                Decimal   @default(0)
  netAmount          Decimal
  destinationType    String    @default("PIX") // PIX ou BANK
  destinationPixKey  String?
  destinationBank    String?
  destinationAgency  String?
  destinationAccount String?
  status             String    @default("PENDING") // AWAITING_CONFIRMATION, PENDING, PROCESSING, COMPLETED, FAILED
  asaasTransferId    String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  // Confirmação de saque por e-mail (F7)
  confirmToken String?   @unique
  confirmedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ MODO CRIADOR (paridade Livepix) ============

model CreatorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  bio           String?
  bannerUrl     String?
  socialLinks   Json?
  minDonation   Decimal  @default(1)
  maxMessageLen Int      @default(200)
  widgetToken   String   @unique
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Donation {
  id               String    @id @default(cuid())
  creatorId        String // User.id do criador que recebe
  payerName        String    @default("Anônimo")
  payerEmail       String?
  message          String?
  amount           Decimal
  method           String    @default("PIX") // PIX, CARD
  status           String    @default("PENDING") // PENDING, PAID, REFUSED, EXPIRED
  provider         String    @default("ASAAS")
  providerId       String?   @unique // id da cobrança no provider (idempotência)
  receiptUrl       String? // comprovante — diferencial anti-"PIX sumiu"
  moderationStatus String    @default("AUTO_OK") // AUTO_OK, FLAGGED, BLOCKED, PENDING_VOICE_REVIEW
  mediaUrl         String?
  mediaType        String? // AUDIO, VIDEO
  goalId           String?
  campaignId       String?
  createdAt        DateTime  @default(now())
  paidAt           DateTime?

  // Mensagem de áudio/vídeo do doador (F10b) — moderação reusa moderationStatus.
  mediaUrl  String?
  mediaType String? // AUDIO, VIDEO

  creator  User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  goal     Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
  @@index([creatorId, createdAt])
}

model AlertConfig {
  id             String   @id @default(cuid())
  creatorId      String   @unique
  soundUrl       String?
  gifUrl         String?
  durationMs     Int      @default(8000)
  ttsEnabled     Boolean  @default(true)
  ttsVoice       String?
  ttsMinAmount   Decimal  @default(0)
  minAlertAmount Decimal  @default(0)
  paused         Boolean  @default(false) // fila pausada pelo criador
  theme          Json?
  updatedAt      DateTime @updatedAt

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

// Fila persistente de alertas do widget — fonte de verdade (Realtime é só o empurrão).
model AlertEvent {
  id          String    @id @default(cuid())
  creatorId   String
  donationId  String?
  type        String    @default("DONATION") // DONATION, SUB, TEST
  payload     Json // { payerName, amount, message, ... } congelado no momento do evento
  createdAt   DateTime  @default(now())
  displayedAt DateTime?
  skippedAt   DateTime?

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, displayedAt])
}

model Goal {
  id            String    @id @default(cuid())
  creatorId     String
  title         String
  targetAmount  Decimal
  currentAmount Decimal   @default(0) // cache derivado das doações PAID
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  creator   User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  donations Donation[]

  @@index([creatorId, isActive])
}

model Campaign {
  id           String    @id @default(cuid())
  creatorId    String
  slug         String
  title        String
  description  String?
  targetAmount Decimal?
  raisedAmount Decimal   @default(0)
  endsAt       DateTime?
  status       String    @default("ACTIVE") // ACTIVE, ENDED, CANCELED
  createdAt    DateTime  @default(now())

  creator   User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  donations Donation[]

  @@unique([creatorId, slug])
}

// Enquetes (F10b) — baixa prioridade, mas confirmada na paridade com a LivePix.
model Poll {
  id        String    @id @default(cuid())
  creatorId String
  question  String
  isActive  Boolean   @default(true)
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  creator User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@index([creatorId, isActive])
}

model PollOption {
  id        String @id @default(cuid())
  pollId    String
  label     String
  voteCount Int    @default(0)

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
}

// Plano de assinatura criado pelo criador (membership).
model CreatorPlan {
  id              String   @id @default(cuid())
  creatorId       String
  name            String
  description     String?
  price           Decimal
  interval        String   @default("MONTHLY")
  rewards         Json? // lista de benefícios exibidos
  discordRoleId   String?
  discordGuildId  String? // ID do servidor Discord onde o cargo existe
  telegramGroupId String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([creatorId])
}

model Subscription {
  id               String    @id @default(cuid())
  planId           String
  subscriberName   String    @default("Apoiador")
  subscriberEmail  String
  status           String    @default("PENDING") // PENDING, ACTIVE, PAST_DUE, CANCELED
  provider         String    @default("ASAAS")
  providerSubId    String?   @unique
  cancelToken      String    @unique @default(cuid()) // link mágico de cancelamento
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())

  // Recompensas automáticas (F4b) — IDs que o assinante informa na hora de assinar.
  discordUserId  String?
  telegramUserId String?
  rewardGranted  Boolean @default(false) // evita grant/revoke repetido no cron

  plan CreatorPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, status])
}

// ============ DINHEIRO (ledger append-only) ============

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) // cache derivado do ledger (única coluna mutável)
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]
}

// APPEND-ONLY: nunca UPDATE/DELETE. Idempotência por providerEventId unique.
model LedgerEntry {
  id              String   @id @default(cuid())
  walletId        String
  type            String // DONATION_IN, CHARGE_IN, SUB_IN, FEE, PAYOUT, ADJUSTMENT
  amount          Decimal // com sinal: crédito positivo, débito negativo
  refType         String? // Donation, Charge, Subscription, Withdrawal...
  refId           String?
  providerEventId String?  @unique
  description     String?
  createdAt       DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

// Subconta do criador no provider (Asaas marketplace) + estado de KYC.
model ProviderAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  provider     String   @default("ASAAS")
  subAccountId String?
  walletId     String? // walletId da subconta — referenciado no split das cobranças
  kycStatus    String   @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  apiKeyEnc    String? // apiKey da subconta cifrada (AES-GCM) — nunca em claro
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ API PÚBLICA (F8 — tabelas criadas agora, baratas) ============

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  scopes     String    @default("read") // csv: read,write,alerts
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String   @default("payment.new") // csv de eventos assinados
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rate limit best-effort (F7) — janela deslizante simples por chave (ex.: "login:email").
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(1)
  windowStart DateTime @default(now())
}

// Conexões OAuth do CRIADOR (F10) — Discord/Twitch/Twitter/Kick, espelha o
// "account.livepix.gg/connections" confirmado na pesquisa de concorrência.
// INERTE sem client id/secret do provider configurado no .env.
model SocialConnection {
  id                String    @id @default(cuid())
  userId            String
  provider          String // DISCORD, TWITCH, TWITTER, KICK
  providerUserId    String
  providerUsername  String?
  accessTokenEnc    String? // cifrado (AES-GCM, src/lib/crypto.ts) — nunca em claro
  refreshTokenEnc   String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}
