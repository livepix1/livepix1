# ==============================================================================
# PixFlow — variáveis de ambiente
# Copie este arquivo para `.env.local` (que NÃO vai pro git) e preencha os valores.
# ==============================================================================

# --- Banco de dados (Postgres / Supabase) ------------------------------------
# Onde pegar: no Supabase do projeto -> botão "Connect" -> aba ORM (Prisma).
# DATABASE_URL = transaction pooler (porta 6543, pgbouncer) para o app/serverless.
# DIRECT_URL   = session pooler (porta 5432) usado pelas migrations do Prisma.
DATABASE_URL="postgresql://postgres.REF:SENHA@aws-1-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.REF:SENHA@aws-1-REGIAO.pooler.supabase.com:5432/postgres"

# --- NextAuth ----------------------------------------------------------------
# URL pública da app. Em dev: http://localhost:3000 ; em prod: seu domínio.
NEXTAUTH_URL="http://localhost:3000"
# Segredo para assinar as sessões (JWT). Gere um com:
#   openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte"

# --- Google OAuth (opcional) -------------------------------------------------
# Onde pegar: Google Cloud Console -> APIs & Services -> Credentials ->
# "OAuth client ID" (tipo Web). Redirect URI:
#   http://localhost:3000/api/auth/callback/google
# Deixe em branco para desativar o login com Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Facebook OAuth (opcional) -----------------------------------------------
# Onde pegar: Meta for Developers -> seu App -> Facebook Login -> Settings.
# Redirect URI: http://localhost:3000/api/auth/callback/facebook
# Deixe em branco para desativar o login com Facebook.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Asaas (pagamentos) ------------------------------------------------------
# Onde pegar: painel do Asaas -> Integrações -> Chave de API.
# Chave de sandbox contém "hmlg" (o cliente detecta e usa a URL de homologação).
# Enquanto estiver vazio/placeholder, os pagamentos ficam INERTES (nenhum dinheiro
# real é movimentado) — é o estado atual do MVP, de propósito.
ASAAS_API_KEY=""
ASAAS_ACCOUNT_ID=""
# Token que você define ao cadastrar o webhook no Asaas; é exigido no header
# "asaas-access-token" das notificações. Sem ele, o webhook não grava nada.
ASAAS_WEBHOOK_SECRET=""

# --- Subcontas Asaas / KYC (F5 — dinheiro real) ------------------------------
# Chave mestra pra cifrar a apiKey de cada subconta de criador antes de gravar no
# banco. Gere com: openssl rand -base64 32 (precisa decodificar pra 32 bytes).
CRYPTO_MASTER_KEY=""
# Protege /api/cron/reconcile e /api/cron/sync-rewards. Vercel Cron manda esse
# valor no header Authorization: Bearer <secret>. Vazio = sem proteção (ok em
# dev local, nunca em produção).
CRON_SECRET=""

# --- Recompensas Discord/Telegram (F4b) --------------------------------------
# Bot do Discord (Developer Portal) com permissão "Manage Roles" no servidor.
DISCORD_BOT_TOKEN=""
# Bot do Telegram (@BotFather), adicionado como admin do grupo/canal.
TELEGRAM_BOT_TOKEN=""

# --- Supabase Realtime + Storage (widget ao vivo + mídia do doador) ----------
# Onde pegar: painel do Supabase -> Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY também são usados
# pelo browser (widget). SUPABASE_SERVICE_ROLE_KEY é usado só no servidor
# (broadcast + upload de mídia do doador no bucket "donation-media").
# Enquanto vazio/placeholder, Realtime e upload de mídia ficam INERTES.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (e-mail transacional, F7 — confirmação de saque) ----------------
# Onde pegar: painel do Resend -> API Keys. Provider de e-mail transacional —
# sem ela, o link de confirmação de saque aparece na resposta da action (modo
# dev) em vez de ser enviado por e-mail de verdade (mesmo padrão INERTE do
# Asaas/CRYPTO_MASTER_KEY: nunca lança erro, só não envia de fato).
RESEND_API_KEY=""

# --- Conexões OAuth do criador (F10) ------------------------------------------
# Cada par é opcional e independente — sem ele, o botão "Conectar" daquela rede
# fica desabilitado. Redirect URI de cada um: /api/oauth/{provider}/callback.
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""
TWITCH_OAUTH_CLIENT_ID=""
TWITCH_OAUTH_CLIENT_SECRET=""
TWITTER_OAUTH_CLIENT_ID=""
TWITTER_OAUTH_CLIENT_SECRET=""
KICK_OAUTH_CLIENT_ID=""
KICK_OAUTH_CLIENT_SECRET=""

# --- ElevenLabs (TTS avançado, vozes PT-BR de alta qualidade) ----------------
# Onde pegar: painel do ElevenLabs -> Profile -> API Keys.
# Enquanto vazio/placeholder, o TTS avançado fica INERTE — o widget usa a voz
# padrão do navegador (Web Speech API) como fallback, sem quebrar nada.
ELEVENLABS_API_KEY=""
