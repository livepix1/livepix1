# ==============================================================================
# PixFlow — variáveis de ambiente
# Copie este arquivo para `.env.local` (que NÃO vai pro git) e preencha os valores.
# ==============================================================================

# --- Banco de dados (Postgres / Supabase) ------------------------------------
# Onde pegar: no Supabase do projeto -> Project Settings -> Database ->
# "Connection string" (URI). Use a porta 6543 (pooler) para serverless/Vercel.
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres?schema=public"

# --- NextAuth ----------------------------------------------------------------
# URL pública da app. Em dev: http://localhost:3000 ; em prod: seu domínio.
NEXTAUTH_URL="http://localhost:3000"
# Segredo para assinar as sessões (JWT). Gere um com:
#   openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte"

# --- Google OAuth (opcional) -------------------------------------------------
# Onde pegar: Google Cloud Console -> APIs & Services -> Credentials ->
# "OAuth client ID" (tipo Web). Redirect URI:
#   http://localhost:3000/api/auth/callback/google
# Deixe em branco para desativar o login com Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Facebook OAuth (opcional) -----------------------------------------------
# Onde pegar: Meta for Developers -> seu App -> Facebook Login -> Settings.
# Redirect URI: http://localhost:3000/api/auth/callback/facebook
# Deixe em branco para desativar o login com Facebook.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Asaas (pagamentos) ------------------------------------------------------
# Onde pegar: painel do Asaas -> Integrações -> Chave de API.
# Chave de sandbox contém "hmlg" (o cliente detecta e usa a URL de homologação).
# Enquanto estiver vazio/placeholder, os pagamentos ficam INERTES (nenhum dinheiro
# real é movimentado) — é o estado atual do MVP, de propósito.
ASAAS_API_KEY=""
ASAAS_ACCOUNT_ID=""
# Token que você define ao cadastrar o webhook no Asaas; é exigido no header
# "asaas-access-token" das notificações. Sem ele, o webhook não grava nada.
ASAAS_WEBHOOK_SECRET=""
